<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>My Heart ❤️</title>

<style>

body{
margin:0;
height:100vh;
display:flex;
justify-content:center;
align-items:center;
background:linear-gradient(135deg,#ff758c,#ff7eb3);
font-family:Arial;
overflow:hidden;
}

/* Floating hearts */
.heart{
position:absolute;
color:white;
font-size:20px;
animation:float 6s linear infinite;
}

@keyframes float{
0%{transform:translateY(100vh) scale(0.5);opacity:1;}
100%{transform:translateY(-10vh) scale(1.2);opacity:0;}
}

/* Envelope */
.envelope{
position:relative;
width:220px;
height:150px;
background:#ff4d6d;
cursor:pointer;
border-radius:5px;
}

.envelope:before{
content:'';
position:absolute;
top:-75px;
left:0;
border-left:110px solid transparent;
border-right:110px solid transparent;
border-bottom:75px solid #ff4d6d;
transition:0.6s;
}

.envelope.open:before{
transform:rotateX(180deg);
top:-10px;
}

.letter{
position:absolute;
width:200px;
height:130px;
background:white;
top:10px;
left:10px;
border-radius:5px;
display:flex;
align-items:center;
justify-content:center;
text-align:center;
padding:10px;
font-size:14px;
transform:translateY(40px);
opacity:0;
transition:0.6s;
}

.envelope.open .letter{
transform:translateY(-120px);
opacity:1;
}

/* Popup */
.popup{
position:fixed;
top:50%;
left:50%;
transform:translate(-50%,-50%) scale(0);
background:rgba(255,255,255,0.9);
padding:25px;
border-radius:12px;
text-align:center;
width:330px;
box-shadow:0 10px 30px rgba(0,0,0,0.3);
transition:0.4s;

/* HER PHOTO BACKGROUND */
background-image:url("her.jpg");
background-size:cover;
background-position:center;
}

.popup::before{
content:"";
position:absolute;
top:0;
left:0;
width:100%;
height:100%;
background:rgba(255,255,255,0.85);
border-radius:12px;
}

/* keep content above bg */
.popup *{
position:relative;
z-index:2;
}

.popup.show{
transform:translate(-50%,-50%) scale(1);
}

/* Top photo */
.love-pic{
width:130px;
height:130px;
border-radius:50%;
object-fit:cover;
margin:10px auto;
display:block;
border:4px solid #ff4d6d;
box-shadow:0 5px 20px rgba(0,0,0,0.3);
animation:heartbeat 1.5s infinite;
}

@keyframes heartbeat{
0%{transform:scale(1);}
50%{transform:scale(1.08);}
100%{transform:scale(1);}
}

button{
margin-top:15px;
padding:8px 15px;
border:none;
background:#ff4d6d;
color:white;
border-radius:6px;
cursor:pointer;
}

#typing{
white-space:pre-line;
font-size:14px;
line-height:1.6;
font-weight:bold;
color:#222;
}

</style>
</head>

<body>

<audio id="bgMusic" loop>
<source src="ciciliya.mp3" type="audio/mpeg">
</audio>

<div class="envelope" onclick="openEnvelope(this)">
<div class="letter">Tap to open 💌</div>
</div>

<div class="popup" id="popup">

<h2>My Heart ❤️</h2>

<img src="her.jpg" class="love-pic">

<p id="typing"></p>

<button onclick="closePopup()">Close</button>

</div>

<script>

const text = `Happy Birthday 🎉

My Heart ❤️,

You are the most beautiful part of my life.
Your smile makes my world brighter every day.

If fate gives me another life,
you'll be the first soul I search for —
and the one I love endlessly.

If meeting me was a bad part of your life
then I'm sorry.

Leaving you for your peace
is my last gift for you :)`;

let i=0;

function typeWriter(){
if(i<text.length){
document.getElementById("typing").innerHTML += text.charAt(i);
i++;
setTimeout(typeWriter,40);
}
}

function openEnvelope(e){

e.classList.add("open");

setTimeout(()=>{
document.getElementById("popup").classList.add("show");
typeWriter();
},800);

document.getElementById("bgMusic").play();
}

function closePopup(){
document.getElementById("popup").classList.remove("show");
}

/* floating hearts */

setInterval(()=>{
let heart=document.createElement("div");

heart.className="heart";
heart.innerHTML="❤";

heart.style.left=Math.random()*100+"vw";
heart.style.fontSize=(15+Math.random()*20)+"px";
heart.style.animationDuration=(4+Math.random()*3)+"s";

document.body.appendChild(heart);

setTimeout(()=>heart.remove(),7000);

},500);

</script>

</body>
</html>
