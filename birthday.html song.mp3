<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Happy Birthday Maha ❤️‍🩹</title>

<style>

body{
margin:0;
height:100vh;
display:flex;
justify-content:center;
align-items:center;
background:linear-gradient(135deg,#ff758c,#ff7eb3);
font-family:Arial;
color:white;
text-align:center;
overflow:hidden;
}

.container{
background:rgba(0,0,0,0.35);
padding:40px;
border-radius:20px;
box-shadow:0 0 25px rgba(0,0,0,0.4);
}

button{
padding:12px 25px;
border:none;
border-radius:10px;
background:white;
color:#ff4d6d;
font-size:16px;
cursor:pointer;
margin-top:20px;
}

/* popup */

.popup{
position:fixed;
top:0;
left:0;
width:100%;
height:100%;
background:rgba(0,0,0,0.6);
display:none;
justify-content:center;
align-items:center;
}

/* envelope */

.envelope{
position:relative;
width:300px;
height:200px;
background:#ff4d6d;
border-radius:10px;
overflow:hidden;
}

.flap{
position:absolute;
top:0;
width:100%;
height:100%;
background:#ff758c;
transform-origin:top;
transition:1s;
}

.envelope.open .flap{
transform:rotateX(180deg);
}

/* letter */

.letter{
position:absolute;
bottom:-220px;
background:white;
color:#333;
width:100%;
height:100%;
padding:20px;
transition:2s;
font-family:cursive;
overflow:auto;
}

.envelope.open .letter{
bottom:0;
}

/* hearts */

.heart{
position:absolute;
bottom:-20px;
font-size:22px;
animation:float 6s linear infinite;
}

@keyframes float{
0%{transform:translateY(0);opacity:1;}
100%{transform:translateY(-110vh);opacity:0;}
}

</style>
</head>

<body>

<div class="container">

<h1>🎉 Happy Birthday Maha ❤️‍🩹</h1>
<p>You are the most beautiful part of my life ❤️</p>

<button onclick="openEnvelope()">💌 Open My Soul</button>

</div>


<div class="popup" id="popup">

<div class="envelope" id="envelope">

<div class="flap"></div>

<div class="letter">

<h3>My Soul ❤️</h3>

<p id="typing"></p>

</div>

</div>

</div>


<audio id="music" loop>
<source src="song.mp3" type="audio/mpeg">
</audio>


<script>

const text = `To the most special person in my life,

Every moment with you feels magical.
Your smile makes my world brighter.

I wish your birthday is filled with happiness,
love, and endless beautiful memories.

If fate gives me another life, you'll be the first soul I search for —
and the one I love endlessly.

If meeting me was a bad part of your life then I'm sorry.

Leaving you for your peace is my last gift for you :) ❤️`;

function openEnvelope(){

document.getElementById("popup").style.display="flex";

setTimeout(()=>{
document.getElementById("envelope").classList.add("open");
typeWriter();
},300);

let music=document.getElementById("music");

music.play().catch(function(error){
console.log("Autoplay blocked:",error);
});

}

let i=0;

function typeWriter(){

if(i < text.length){

document.getElementById("typing").innerHTML += text.charAt(i);

i++;

setTimeout(typeWriter,40);

}

}

function createHeart(){

const heart=document.createElement("div");

heart.classList.add("heart");

heart.innerHTML="❤️";

heart.style.left=Math.random()*100+"vw";

heart.style.animationDuration=(Math.random()*3+3)+"s";

document.body.appendChild(heart);

setTimeout(()=>heart.remove(),6000);

}

setInterval(createHeart,300);

</script>

</body>
</html>
